# ===================================================================
# Hospital Appointment and Patient Management System - Configuration Example
# Copy this file to application.properties and update the credentials,
# OR set the environment variables: DB_URL, DB_USERNAME, DB_PASSWORD
# ===================================================================

# Application Info
spring.application.name=hospital-appointment-system
server.port=${PORT:8080}

# Database Configuration (MySQL via JDBC / HikariCP)
# Supports direct environment variables: DB_URL, DB_USERNAME, DB_PASSWORD
# Local development default:
#   DB_URL=jdbc:mysql://localhost:3306/hospital_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# Cloud MySQL (e.g. Aiven Free MySQL with required TLS):
#   DB_URL=jdbc:mysql://<HOST>:<PORT>/<DATABASE>?sslMode=REQUIRED
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/hospital_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:YOUR_MYSQL_PASSWORD_HERE}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# HikariCP Connection Pool
spring.datasource.hikari.pool-name=HospitalHikariCP
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.idle-timeout=30000
spring.datasource.hikari.connection-timeout=20000

# JSON Serialization
spring.jackson.date-format=yyyy-MM-dd
spring.jackson.time-zone=UTC
